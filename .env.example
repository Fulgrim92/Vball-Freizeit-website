# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Leave both empty to run the demo on mock data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Donation page behind the "Seite unterstützen" buttons (Buy Me a Coffee, Ko-fi, PayPal.me …).
# Leave empty to show a "kommt bald" note instead.
VITE_SUPPORT_URL=
